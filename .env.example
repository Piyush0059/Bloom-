# Copy these variables into Vercel Project Settings -> Environment Variables.
# These are placeholders. Never commit real credentials.
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
BLOOM_ACCESS_PASSWORD=replace_with_a_unique_password_at_least_12_characters
BLOOM_SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters
# Friend voice output is optional and stays disabled unless all three values below are valid.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
BLOOM_VOICE_CONSENT_CONFIRMED=false
