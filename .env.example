# DEVELOPMENT PLACEHOLDERS ONLY. Never put real keys in this file or a Git commit.
# Native Android app (local Secrets Gradle Plugin reads the actual local .env):
GEMINI_API_KEY=replace_with_your_gemini_api_key
# Web app: add the same key in Vercel Project Settings -> Environment Variables, not client code.
GEMINI_MODEL=gemini-3.8-flash
BLOOM_ACCESS_PASSWORD=replace_with_a_unique_password_at_least_12_characters
BLOOM_SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters
# Voice output stays off unless a valid replica ID and explicit consent flag are configured.
# Obtain the ID in Google AI Studio Voice Replication after the speaker supplies both required recordings.
BLOOM_CUSTOM_VOICE_ID=""
BLOOM_VOICE_CONSENT_CONFIRMED=false
